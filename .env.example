# Переменные окружения для аутентификации
# Скопируйте этот файл в .env.local и установите свои пароли

# Пароль для пользователя admin
ADMIN_PASSWORD=your_secure_admin_password

# Пароль для пользователя user  
USER_PASSWORD=your_secure_user_password

# Окружение (production/development)
NODE_ENV=development
